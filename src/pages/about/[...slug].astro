---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const workItems = (await getCollection("work"))
    .sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf());
  return workItems.map((item) => ({
    params: { slug: item.slug },
    props: item,
  }));
}
type Props = CollectionEntry<"work">;

const workItem = Astro.props;
const { Content } = await workItem.render();
---

<PageLayout title={workItem.data.company} description={`${workItem.data.role} at ${workItem.data.company}`}>
  <Container>
    <div class="animate">
      <BackToPrev href="/about"> Back to work </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {workItem.data.company}
      </div>
      <div class="animate text-lg font-medium">
        {workItem.data.role}
      </div>
      <div class="animate text-sm text-gray-600 dark:text-gray-400">
        <FormattedDate date={workItem.data.dateStart} /> - {typeof workItem.data.dateEnd === "string" ? workItem.data.dateEnd : <FormattedDate date={workItem.data.dateEnd} />}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
