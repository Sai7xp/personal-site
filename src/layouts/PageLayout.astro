---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    
    <script>
      const initCopyButtons = () => {
        const codeBlocks = document.querySelectorAll("article pre");
        
        codeBlocks.forEach((pre) => {
          // Skip if already initialized
          if (pre.dataset.copyInitialized) return;
          pre.dataset.copyInitialized = "true";
          
          pre.style.cursor = "pointer";
          
          const copyCode = async (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const code = pre.querySelector("code");
            if (!code) return;
            
            const text = code.textContent;
            
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(text);
              } else {
                // Fallback for older browsers
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand("copy");
                document.body.removeChild(textArea);
              }
              
              // Show copied state
              pre.classList.add("copied");
              
              // Remove copied state after 2 seconds
              setTimeout(() => {
                pre.classList.remove("copied");
              }, 2000);
            } catch (err) {
              console.error("Failed to copy:", err);
            }
          };
          
          pre.addEventListener("click", copyCode);
          pre.addEventListener("touchend", copyCode);
        });
      };

      // Initialize on page load
      document.addEventListener("DOMContentLoaded", initCopyButtons);
      
      // Reinitialize on Astro navigation
      document.addEventListener("astro:page-load", initCopyButtons);
      
      // Also run immediately in case DOM is already loaded
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCopyButtons);
      } else {
        initCopyButtons();
      }
    </script>
  </body>
</html>
